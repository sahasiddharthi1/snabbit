{
  "name": "snabbit-whatsapp-bot",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "dev:server": "rolldown server/dev-server.ts --file .dev/dev-server.mjs --format esm --platform node && node .dev/dev-server.mjs",
    "dev:qr": "tsx server/wa-qr.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@wppconnect-team/wppconnect": "^2.3.0",
    "dotenv": "^17.4.2",
    "razorpay": "^2.9.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "oxlint": "^0.16.0",
    "postcss": "^8.5.0",
    "rolldown": "^1.0.0-beta.14",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
